# Copy to .env.local for `npm run dev`; set the same keys in Vercel → Settings → Environment Variables.

# MongoDB Atlas connection string (Atlas → Connect → Drivers). Allow 0.0.0.0/0 in Network Access for Vercel.
MONGODB_URI=
# Optional, defaults to cn_visualizer
MONGODB_DB=

# Random 32+ byte secret for signing session cookies: `npx auth secret` or `openssl rand -base64 32`
AUTH_SECRET=

# Google Cloud → APIs & Services → Credentials → OAuth client (Web application).
# Authorised redirect URIs — add BOTH, for every origin (localhost and the Vercel domain):
#   http://localhost:3100/api/auth/callback/srm
#   http://localhost:3100/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Optional: GitHub → Settings → Developer settings → OAuth Apps. Callback: <origin>/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Faculty emails, comma separated. Must sign in with Google to get the faculty role.
FACULTY_EMAILS=

# SRM sign-in by emailed code. SRM's Google Workspace blocks unapproved apps, so this is how SRM students get in.
# Any SMTP account works; the defaults are for Gmail. SMTP_PASS must be a Gmail App Password
# (Google Account → Security → 2-Step Verification → App passwords), not the normal password.
# Without these, `next dev` prints codes to the terminal instead of sending them.
SMTP_USER=
SMTP_PASS=
# Optional: SMTP_HOST (default smtp.gmail.com), SMTP_PORT (default 465), MAIL_FROM ("CN Visualizer <you@gmail.com>")

# Set to 1 once SRM IT approves the Google OAuth app. That brings back the "SRM Google" button.
SRM_GOOGLE_APPROVED=
